@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
	<div class="container-fluid">
		<a class="navbar-brand" href="">MediaManager</a>
	</div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
	<nav class="nav flex-column">
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
				<span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 总览
			</NavLink>
		</div>

		<AuthorizeView>
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="items">
						<span class="bi bi-table-nav-menu" aria-hidden="true"></span> 条目
					</NavLink>
				</div>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="downloads">
						<span class="bi bi-cloud-download-nav-menu" aria-hidden="true"></span> 下载任务
					</NavLink>
				</div>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="subscriptions">
						<span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 订阅
					</NavLink>
				</div>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="selection-rules">
						<span class="bi bi-sliders-nav-menu" aria-hidden="true"></span> 择优规则
					</NavLink>
				</div>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="notifications">
						<span class="bi bi-bell-fill-nav-menu" aria-hidden="true"></span> 通知
					</NavLink>
				</div>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="settings">
						<span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> 设置
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView>
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="Account/Manage">
						<span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> 用户
					</NavLink>
				</div>
				<div class="nav-item px-3">
					<form action="Account/Logout" method="post">
						<AntiforgeryToken/>
						<input type="hidden" name="ReturnUrl" value="@currentUrl"/>
						<button type="submit" class="nav-link">
							<span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> 退出
						</button>
					</form>
				</div>
			</Authorized>
			<NotAuthorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="Account/Login">
						<span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> 登录
					</NavLink>
				</div>
			</NotAuthorized>
		</AuthorizeView>
	</nav>
</div>

@code {
	private string? currentUrl;

	protected override void OnInitialized()
	{
		currentUrl                        =  NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
		NavigationManager.LocationChanged += OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
		StateHasChanged();
	}

	public void Dispose()
	{
		NavigationManager.LocationChanged -= OnLocationChanged;
	}

}
