@page "/"
@rendermode InteractiveServer
@using MediaManager.Features.Dashboard
@using MediaManager.Features.Subscriptions
@using MediaManager.Components.Pages.Downloads
@using MediaManager.Components.Pages.Subscriptions
@using MediaManager.Features.Downloads
@attribute [Authorize]
@inject DashboardQueries DashboardService
@inject DownloadService DownloadService
@inject SubscriptionService SubscriptionService
@inject ILogger<Home> Logger

<PageTitle>总览 - MediaManager</PageTitle>

<h1>总览</h1>

<p class="lead">RSS 抓取评估与下载闭环正在运行；已选择的条目可在详情页创建下载任务。</p>

<div class="d-flex flex-wrap gap-2 mb-3">
	<button type="button" class="btn btn-primary" aria-expanded="@_showTorrentForm" @onclick="ToggleTorrentForm">
		<span class="bi bi-cloud-arrow-down me-1" aria-hidden="true"></span>添加 Torrent 下载
	</button>
	<button type="button" class="btn btn-outline-primary" aria-expanded="@_showOneShotForm" @onclick="ToggleOneShotForm">
		<span class="bi bi-rss me-1" aria-hidden="true"></span>添加一次性 RSS
	</button>
</div>

@if (_showTorrentForm)
{
	<div class="card mb-3">
		<div class="card-body">
			<h2 class="h5">添加 Torrent 下载</h2>
			<p class="text-body-secondary small">选择种子后确认加入；任务不关联订阅与条目，按种子内名称命名。</p>
			<div class="row g-3 align-items-end">
				<div class="col-md-7">
					<label class="form-label" for="dashboard-torrent-file">Torrent 文件</label>
					<div>
						<InputFile id="dashboard-torrent-file" class="visually-hidden" accept=".torrent"
						           disabled="@_busy" OnChange="SelectTorrentFile"/>
						<label for="dashboard-torrent-file" class="btn btn-outline-primary mb-0 @(_busy ? "disabled" : string.Empty)">
							选择 .torrent 文件
						</label>
						@if (_torrentFile is not null)
						{
							<span class="ms-2">@_torrentFile.Name</span>
						}
						else
						{
							<span class="ms-2 small text-body-secondary">最大 10 MB</span>
						}
					</div>
				</div>
				<div class="col-md-5 d-flex gap-2">
					<button type="button" class="btn btn-primary" disabled="@(_busy || _torrentFile is null)"
					        @onclick="ConfirmTorrentDownload">
						@(_busy ? "正在登记…" : "确认并加入下载")
					</button>
					<button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="ToggleTorrentForm">取消</button>
				</div>
			</div>
		</div>
	</div>
}

@if (_showOneShotForm)
{
	<EditForm Model="_oneShotDraft" OnValidSubmit="CreateOneShotSubscription" FormName="dashboard-one-shot-subscription">
		<DataAnnotationsValidator/>
		<div class="card mb-3">
			<div class="card-body">
				<h2 class="h5">添加一次性 RSS</h2>
				<p class="text-body-secondary small">添加后立即抓取一次，不参与定时刷新。</p>
				<div class="row g-3">
					<div class="col-md-7">
						<label class="form-label" for="dashboard-one-shot-url">RSS 地址</label>
						<InputText id="dashboard-one-shot-url" class="form-control" type="url"
						           @bind-Value="_oneShotDraft.FeedUrl"/>
						<ValidationMessage For="() => _oneShotDraft.FeedUrl"/>
					</div>
					<div class="col-md-5">
						<label class="form-label" for="dashboard-one-shot-name">名称（可选）</label>
						<InputText id="dashboard-one-shot-name" class="form-control" placeholder="留空则使用域名"
						           @bind-Value="_oneShotDraft.Name"/>
					</div>
				</div>
				<div class="mt-3 d-flex gap-2">
					<button type="submit" class="btn btn-primary" disabled="@_busy">
						@(_busy ? "正在添加…" : "添加并立即抓取")
					</button>
					<button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="ToggleOneShotForm">取消</button>
				</div>
			</div>
		</div>
	</EditForm>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
	<div class="alert @(_operationSucceeded ? "alert-success" : "alert-danger")" role="status">@_message</div>
}

<div class="row g-3">
	<div class="col-md-3">
		<div class="card h-100">
			<div class="card-body">
				<h2 class="h5">订阅</h2>
				<p class="display-6 mb-1">@(_snapshot?.EnabledSubscriptions ?? 0)</p>
				<p class="text-body-secondary mb-0">已启用的 RSS 订阅</p>
			</div>
		</div>
	</div>
	<div class="col-md-3">
		<div class="card h-100">
			<div class="card-body">
				<h2 class="h5">已选择条目</h2>
				<p class="display-6 mb-1">@(_snapshot?.AcceptedItems ?? 0)</p>
				<p class="text-body-secondary mb-0">可在详情页创建下载</p>
			</div>
		</div>
	</div>
	<div class="col-md-3">
		<div class="card h-100">
			<div class="card-body">
				<h2 class="h5">进行中下载</h2>
				<p class="display-6 mb-1">@(_snapshot?.ActiveDownloads ?? 0)</p>
				<p class="text-body-secondary mb-0">待提交、下载中或已暂停</p>
			</div>
		</div>
	</div>
	<div class="col-md-3">
		<div class="card h-100">
			<div class="card-body">
				<h2 class="h5">待处理</h2>
				<p class="display-6 mb-1">@(_snapshot?.NeedsAttentionItems ?? 0)</p>
				<p class="text-body-secondary mb-0">无法解析、关联失败或多集合集</p>
			</div>
		</div>
	</div>
</div>

<div class="mt-3 text-body-secondary small">
	队列中任务：@(_snapshot?.PendingWorkItems ?? 0) · 最近刷新：@(_snapshot?.LastRefreshAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "尚未刷新")
</div>

@code {
	private DashboardSnapshot?         _snapshot;
	private readonly OneShotSubscriptionDraft _oneShotDraft = new();
	private          IBrowserFile?      _torrentFile;
	private          bool              _showTorrentForm;
	private          bool              _showOneShotForm;
	private          bool              _busy;
	private          bool              _operationSucceeded;
	private          string?           _message;

	protected override async Task OnInitializedAsync()
	{
		_snapshot = await DashboardService.GetSnapshotAsync();
	}

	private void ToggleTorrentForm()
	{
		_showTorrentForm = !_showTorrentForm;
		if (_showTorrentForm) _showOneShotForm = false;
		else _torrentFile = null;
		_message = null;
	}

	private void ToggleOneShotForm()
	{
		_showOneShotForm = !_showOneShotForm;
		if (_showOneShotForm) _showTorrentForm = false;
		_message = null;
	}

	private void SelectTorrentFile(InputFileChangeEventArgs args)
	{
		_torrentFile = args.File;
		_message     = null;
	}

	private async Task ConfirmTorrentDownload()
	{
		if (_torrentFile is null) return;

		_busy    = true;
		_message = null;
		try
		{
			if (_torrentFile.Size > DownloadTasksPageViewModel.MaxTorrentUploadBytes)
				throw new InvalidOperationException("种子文件超过 10 MB，已拒绝。");

			await using var fileStream = _torrentFile.OpenReadStream(
				maxAllowedSize: DownloadTasksPageViewModel.MaxTorrentUploadBytes);
			using var buffer = new MemoryStream();
			await fileStream.CopyToAsync(buffer);
			await DownloadService.CreateFromUploadAsync(buffer.ToArray());
			_operationSucceeded = true;
			_message            = "Torrent 已登记，等待提交下载器。";
			_torrentFile        = null;
			_showTorrentForm    = false;
		}
		catch (InvalidOperationException exception)
		{
			_operationSucceeded = false;
			_message            = exception.Message;
		}
		catch (Exception exception)
		{
			Logger.LogWarning(exception, "总览页上传 Torrent 失败。");
			_operationSucceeded = false;
			_message            = "上传或登记失败，请查看服务日志。";
		}
		finally
		{
			_busy = false;
		}
	}

	private async Task CreateOneShotSubscription()
	{
		_busy    = true;
		_message = null;
		try
		{
			var request = new SaveSubscriptionRequest(null, _oneShotDraft.Name?.Trim() ?? string.Empty,
			                                          _oneShotDraft.FeedUrl.Trim(), true, 30, null, IsOneShot: true);
			await SubscriptionService.SaveAsync(request);
			_operationSucceeded = true;
			_message            = "一次性 RSS 已添加，正在立即抓取。";
			_oneShotDraft.Reset();
			_showOneShotForm = false;
		}
		catch (ArgumentException exception)
		{
			_operationSucceeded = false;
			_message            = exception.Message;
		}
		catch (Exception exception)
		{
			Logger.LogWarning(exception, "总览页添加一次性 RSS 失败。");
			_operationSucceeded = false;
			_message            = "添加失败，请查看服务日志。";
		}
		finally
		{
			_busy = false;
		}
	}

}
