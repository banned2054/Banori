@page "/subscriptions"
@rendermode InteractiveServer
@attribute [Authorize]
@using MediaManager.Data
@using MediaManager.Features.Proxies
@using MediaManager.Features.Subscriptions
@implements IDisposable

@inject SubscriptionService                 SubscriptionService
@inject ProxyService                        ProxyService
@inject ILogger<SubscriptionsPageViewModel> Logger
@inject IJSRuntime                          JsRuntime

<PageTitle>订阅 - MediaManager</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
	<div>
		<h1 class="mb-1">RSS 订阅</h1>
		<p class="text-body-secondary mb-0">RSS 地址会加密保存；本阶段只抓取、分析和预览，不会自动下载。</p>
	</div>
	<button class="btn btn-primary" @onclick="_vm.BeginCreate">新建订阅</button>
</div>

@if (!string.IsNullOrEmpty(_vm.StatusMessage))
{
	<div class="alert @(_vm.OperationSucceeded ? "alert-success" : "alert-danger")" role="status">@_vm.StatusMessage</div>
}

@if (_vm.Editing)
{
	<EditForm Model="_vm.Draft" OnValidSubmit="SaveAsync" FormName="subscription-editor">
		<DataAnnotationsValidator/>
		<div class="card mb-4">
			<div class="card-body">
				<h2 class="h5">@(_vm.Draft.Id is null ? "新建订阅" : "编辑订阅")</h2>
				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label" for="subscription-name">名称</label>
						<InputText id="subscription-name" class="form-control" @bind-Value="_vm.Draft.Name"/>
						<ValidationMessage For="() => _vm.Draft.Name"/>
					</div>
					<div class="col-md-6">
						<label class="form-label" for="subscription-url">RSS 地址</label>
						<InputText id="subscription-url" class="form-control" type="url" @bind-Value="_vm.Draft.FeedUrl"/>
						<ValidationMessage For="() => _vm.Draft.FeedUrl"/>
						@if (_vm.Draft.Id is not null)
						{
							<div class="form-text">留空表示继续使用已保存地址。</div>
						}
					</div>
					<div class="col-md-4">
						<label class="form-label" for="refresh-interval">刷新周期（分钟）</label>
						<InputNumber id="refresh-interval" class="form-control" @bind-Value="_vm.Draft.RefreshIntervalMinutes"/>
						<ValidationMessage For="() => _vm.Draft.RefreshIntervalMinutes"/>
					</div>
					<div class="col-md-4">
						<label class="form-label" for="subject-id">固定 Subject ID（可选）</label>
						<InputNumber id="subject-id" class="form-control" @bind-Value="_vm.Draft.FixedSubjectId"/>
						<div class="form-text">填写后，该订阅的条目都固定使用此 Subject，不再自动推断。</div>
					</div>
					<div class="col-md-4">
						<label class="form-label" for="subscription-proxy">代理（可选）</label>
						<select id="subscription-proxy" class="form-select" @bind="_vm.Draft.ProxyId">
							<option value="">不使用代理（直连）</option>
							@foreach (var proxy in _vm.Proxies)
							{
								<option value="@proxy.Id">@proxy.Name（@ProtocolLabel(proxy.Protocol)）</option>
							}
						</select>
						<div class="form-text">RSS 抓取、条目页面解析与种子下载都走此代理。代理可在<a href="settings#network-proxy">设置的「网络代理」</a>中维护。</div>
					</div>
					<div class="col-md-4 d-flex align-items-center pt-4">
						<div class="form-check">
							<InputCheckbox id="subscription-enabled" class="form-check-input" @bind-Value="_vm.Draft.IsEnabled"/>
							<label class="form-check-label" for="subscription-enabled">启用定时刷新</label>
						</div>
					</div>
				</div>
				<div class="mt-3 d-flex gap-2">
					<button type="submit" class="btn btn-primary" disabled="@_vm.Saving">@(_vm.Saving ? "正在保存…" : "保存")</button>
					<button type="button" class="btn btn-outline-secondary" @onclick="_vm.CancelEdit">取消</button>
				</div>
			</div>
		</div>
	</EditForm>
}

@if (!_vm.Loaded)
{
	<p>正在加载…</p>
}
else if (_vm.Subscriptions.Count == 0)
{
	<div class="empty-state">还没有订阅。新建一个 RSS 订阅后，后台会立即执行首次刷新。</div>
}
else
{
	<div class="table-responsive">
		<table class="table align-middle">
			<thead>
			<tr>
				<th>订阅</th><th>状态</th><th>刷新周期</th><th>最近刷新</th><th>下次刷新</th><th class="text-end">操作</th>
			</tr>
			</thead>
			<tbody>
			@foreach (var subscription in _vm.Subscriptions)
			{
				<tr>
					<td>
						<div class="fw-semibold">@subscription.Name</div>
						<div class="small text-body-secondary text-break">@subscription.FeedUrlDisplay</div>
						@if (subscription.FixedSubjectId is not null)
						{
							<span class="small text-body-secondary">固定 Subject #@subscription.FixedSubjectId</span>
						}
					</td>
					<td>
						<span class="badge @(subscription.IsEnabled ? "text-bg-success" : "text-bg-secondary")">
							@(subscription.IsEnabled ? "已启用" : "已停用")
						</span>
						@if (subscription.LatestWorkStatus is not null)
						{
							<div class="small mt-1">任务：@WorkStatusText(subscription.LatestWorkStatus.Value)</div>
						}
						@if (!string.IsNullOrEmpty(subscription.LastError))
						{
							<div class="small text-danger mt-1">@subscription.LastError</div>
						}
					</td>
					<td>@($"{subscription.RefreshIntervalMinutes} 分钟")</td>
					<td>@FormatTime(subscription.LastRefreshCompletedAtUtc)</td>
					<td>@(subscription.IsEnabled ? FormatTime(subscription.NextRefreshAtUtc) : "—")</td>
					<td class="text-end text-nowrap">
						<button class="btn btn-sm btn-outline-primary me-1" @onclick="() => RefreshAsync(subscription.Id)">立即刷新</button>
						<button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => _vm.BeginEdit(subscription)">编辑</button>
						<button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(subscription)">删除</button>
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
}

@code {
	private readonly CancellationTokenSource    _cts = new();
	private          SubscriptionsPageViewModel _vm  = null!;

	protected override void OnInitialized()
	{
		_vm = new SubscriptionsPageViewModel(SubscriptionService, ProxyService, Logger);
	}

	protected override Task OnInitializedAsync() => RunAsync(_vm.LoadAsync);

	private Task SaveAsync() => RunAsync(_vm.SaveAsync);

	private Task RefreshAsync(Guid id)
	{
		return RunAsync(token => _vm.RequestRefreshAsync(id, token));
	}

	private async Task DeleteAsync(SubscriptionView subscription)
	{
		if (!await JsRuntime.InvokeAsync<bool>("confirm", $"删除订阅“{subscription.Name}”及其所有条目？")) return;
		await RunAsync(token => _vm.DeleteAsync(subscription.Id, subscription.Name, token));
	}

	/// <summary>页面离开后取消进行中的查询属于预期，不向线路报错。</summary>
	private async Task RunAsync(Func<CancellationToken, Task> operation)
	{
		try
		{
			await operation(_cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	public void Dispose()
	{
		_cts.Cancel();
		_cts.Dispose();
	}

	private static string FormatTime(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";

	private static string ProtocolLabel(ProxyProtocol protocol)
	{
		return protocol switch
		{
			ProxyProtocol.Socks4 => "SOCKS4",
			ProxyProtocol.Socks5 => "SOCKS5",
			_                    => "HTTP"
		};
	}

	private static string WorkStatusText(RefreshWorkStatus status)
	{
		return status switch
		{
			RefreshWorkStatus.Pending   => "等待中",
			RefreshWorkStatus.Running   => "执行中",
			RefreshWorkStatus.Succeeded => "成功",
			RefreshWorkStatus.Failed    => "失败",
			_                           => status.ToString()
		};
	}

}
