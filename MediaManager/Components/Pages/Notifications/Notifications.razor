@page "/notifications"
@rendermode InteractiveServer
@attribute [Authorize]
@using MediaManager.Data
@using MediaManager.Features.Notifications
@implements IDisposable

@inject NotificationDeliveryService           DeliveryService
@inject ILogger<NotificationsPageViewModel> Logger

<PageTitle>通知投递 - MediaManager</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h1 class="mb-1">通知投递</h1>
		<div class="text-body-secondary">按渠道独立记录发送结果；失败自动退避重试，重试用尽后可在此人工重试。远端已接收而响应丢失时可能重复投递。</div>
	</div>
	<button class="btn btn-outline-secondary" disabled="@(!_vm.Loaded || _vm.Retrying)" @onclick="RefreshAsync">刷新</button>
</div>

@if (!_vm.Loaded)
{
	<p>正在加载…</p>
}
else if (_vm.Deliveries.Count == 0)
{
	<p class="text-body-secondary">还没有投递记录。在设置页启用通知渠道后，下载开始与下载失败事件会记录在这里。</p>
}
else
{
	<div class="table-responsive">
		<table class="table align-middle">
			<thead>
			<tr>
				<th>时间</th>
				<th>渠道</th>
				<th>事件</th>
				<th>内容</th>
				<th>状态</th>
				<th class="text-end">操作</th>
			</tr>
			</thead>
			<tbody>
			@foreach (var delivery in _vm.Deliveries)
			{
				<tr>
					<td class="small text-body-secondary">
						<div>入队：@delivery.CreatedAtUtc.ToLocalTime().ToString("MM-dd HH:mm:ss")</div>
						@if (delivery.DeliveredAtUtc is { } delivered)
						{
							<div>送达：@delivered.ToLocalTime().ToString("MM-dd HH:mm:ss")</div>
						}
					</td>
					<td>@ChannelText(delivery.Channel)</td>
					<td>@EventText(delivery.EventType)</td>
					<td class="small" style="max-width: 420px;">
						<div>@delivery.Title</div>
						<div class="text-body-secondary text-break">@delivery.Message</div>
						@if (!string.IsNullOrEmpty(delivery.LastError))
						{
							<div class="text-danger text-break">@delivery.LastError</div>
						}
					</td>
					<td>
						<span class="badge @StatusClass(delivery.Status)">@StatusText(delivery)</span>
					</td>
					<td class="text-end">
						@if (delivery.Status == NotificationDeliveryStatus.Failed)
						{
							<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Retrying" @onclick="() => RetryAsync(delivery.Id)">重试</button>
						}
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
}

@if (!string.IsNullOrEmpty(_vm.Message))
{
	<div class="alert @(_vm.Succeeded ? "alert-success" : "alert-danger") mt-3" role="status">
		@_vm.Message
	</div>
}

@code {

	private readonly CancellationTokenSource _cts = new();
	private          NotificationsPageViewModel _vm = null!;

	protected override void OnInitialized()
	{
		_vm = new NotificationsPageViewModel(DeliveryService);
	}

	protected override Task OnInitializedAsync()
	{
		return RunAsync(_vm.LoadAsync);
	}

	private Task RefreshAsync()
	{
		return RunAsync(_vm.LoadAsync);
	}

	private Task RetryAsync(Guid id)
	{
		return RunAsync(token => _vm.RetryAsync(id, token));
	}

	private static string ChannelText(NotificationChannel channel)
	{
		return channel switch
		{
			NotificationChannel.Telegram => "Telegram",
			NotificationChannel.Gotify   => "Gotify",
			_                            => channel.ToString()
		};
	}

	private static string EventText(NotificationEventType eventType)
	{
		return eventType switch
		{
			NotificationEventType.DownloadStarted => "下载开始",
			NotificationEventType.DownloadFailed  => "下载失败",
			_                                     => eventType.ToString()
		};
	}

	private static string StatusText(NotificationDelivery delivery)
	{
		return delivery.Status switch
		{
			NotificationDeliveryStatus.Pending   => delivery.NextAttemptAtUtc is { } next
				? $"待重试（{next.ToLocalTime().ToString("HH:mm")}）"
				: "待发送",
			NotificationDeliveryStatus.Delivered => "已送达",
			NotificationDeliveryStatus.Failed    => $"失败（{delivery.AttemptCount} 次）",
			_                                    => delivery.Status.ToString()
		};
	}

	private static string StatusClass(NotificationDeliveryStatus status)
	{
		return status switch
		{
			NotificationDeliveryStatus.Pending   => "text-bg-secondary",
			NotificationDeliveryStatus.Delivered => "text-bg-success",
			NotificationDeliveryStatus.Failed    => "text-bg-danger",
			_                                    => "text-bg-secondary"
		};
	}

	/// <summary>页面离开后取消进行中的查询属于预期，不向线路报错。</summary>
	private async Task RunAsync(Func<CancellationToken, Task> operation)
	{
		try
		{
			await operation(_cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	public void Dispose()
	{
		_cts.Cancel();
		_cts.Dispose();
	}

}
