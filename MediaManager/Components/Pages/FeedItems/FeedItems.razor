@page "/items"
@rendermode InteractiveServer
@attribute [Authorize]
@using MediaManager.Features.FeedItems
@using MediaManager.Features.Subscriptions
@implements IDisposable

@inject FeedItemQueries Queries

<PageTitle>条目 - MediaManager</PageTitle>

<h1>条目与解析</h1>
<p class="text-body-secondary">每条记录保留原始标题、解析结果、Subject 关联、筛选理由和命名预览。</p>

<div class="btn-group mb-3" role="group" aria-label="条目状态筛选">
	<button class="btn @FilterClass(null)" @onclick="() => SetFilterAsync(null)">全部</button>
	<button class="btn @FilterClass(FeedItemStatus.Accepted)" @onclick="() => SetFilterAsync(FeedItemStatus.Accepted)">已选择</button>
	<button class="btn @FilterClass(FeedItemStatus.Rejected)" @onclick="() => SetFilterAsync(FeedItemStatus.Rejected)">已拒绝</button>
	<button class="btn @FilterClass(FeedItemStatus.NeedsReview)" @onclick="() => SetFilterAsync(FeedItemStatus.NeedsReview)">待处理</button>
	<button class="btn @FilterClass(FeedItemStatus.Failed)" @onclick="() => SetFilterAsync(FeedItemStatus.Failed)">失败</button>
</div>

@if (!_vm.Loaded)
{
	<p>正在加载…</p>
}
else if (_vm.Items.Count == 0)
{
	<div class="empty-state">当前筛选下没有条目。</div>
}
else
{
	<div class="table-responsive">
		<table class="table align-middle">
			<thead>
			<tr>
				<th>发布时间</th><th>条目</th><th>解析</th><th>决策</th><th></th>
			</tr>
			</thead>
			<tbody>
			@foreach (var item in _vm.Items)
			{
				<tr>
					<td class="text-nowrap">@(item.PublishedAtUtc?.ToLocalTime().ToString("MM-dd HH:mm") ?? "—")</td>
					<td>
						<div class="small text-body-secondary">@item.SubscriptionName</div>
						<div class="feed-title">@item.Title</div>
					</td>
					<td>
						@if (item.ParsedTitle is not null)
						{
							<div>@item.ParsedTitle</div>
							<div class="small text-body-secondary">E@(item.Episode?.ToString() ?? "?") · @item.Group · @item.Language · @item.Resolution</div>
						}
						else
						{
							<span>—</span>
						}
					</td>
					<td>
						<span class="badge @StatusClass(item.Status)">@StatusText(item.Status)</span>
						<div class="small mt-1 decision-reason">@item.Reason</div>
					</td>
					<td>
						<a class="btn btn-sm btn-outline-secondary" href="items/@item.Id">详情</a>
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
}

@code {
	private readonly CancellationTokenSource _cts = new();
	private          FeedItemsPageViewModel  _vm  = null!;

	protected override void OnInitialized()
	{
		_vm = new FeedItemsPageViewModel(Queries);
	}

	protected override Task OnInitializedAsync()
	{
		return RunAsync(_vm.LoadAsync);
	}

	private Task SetFilterAsync(FeedItemStatus? filter)
	{
		return RunAsync(token => _vm.SetFilterAsync(filter, token));
	}

	private string FilterClass(FeedItemStatus? status)
	{
		return _vm.IsSelected(status) ? "btn-primary" : "btn-outline-primary";
	}

	/// <summary>页面离开后取消进行中的查询属于预期，不向线路报错。</summary>
	private async Task RunAsync(Func<CancellationToken, Task> operation)
	{
		try
		{
			await operation(_cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	public void Dispose()
	{
		_cts.Cancel();
		_cts.Dispose();
	}

	internal static string StatusClass(FeedItemStatus status)
	{
		return status switch
		{
			FeedItemStatus.Accepted    => "text-bg-success",
			FeedItemStatus.Rejected    => "text-bg-secondary",
			FeedItemStatus.NeedsReview => "text-bg-warning",
			FeedItemStatus.Failed      => "text-bg-danger",
			_                          => "text-bg-info"
		};
	}

	internal static string StatusText(FeedItemStatus status)
	{
		return status switch
		{
			FeedItemStatus.Accepted    => "已选择",
			FeedItemStatus.Rejected    => "已拒绝",
			FeedItemStatus.NeedsReview => "待处理",
			FeedItemStatus.Failed      => "失败",
			_                          => "处理中"
		};
	}

}
