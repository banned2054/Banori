@page "/items/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using MediaManager.Features.Downloads
@using MediaManager.Features.FeedItems
@using MediaManager.Features.Subscriptions
@implements IDisposable

@inject FeedItemQueries                       Queries
@inject FeedItemEvaluator                     Evaluator
@inject DownloadService                       DownloadService
@inject ILogger<FeedItemDetailsPageViewModel> Logger

<PageTitle>条目详情 - MediaManager</PageTitle>

@if (!_vm.Loaded)
{
	<p>正在加载…</p>
}
else if (_vm.Item is null)
{
	<h1>条目不存在</h1>
	<a href="items">返回条目列表</a>
}
else
{
	<div class="d-flex justify-content-between align-items-start mb-3">
		<div>
			<h1 class="mb-1">条目详情</h1>
			<div class="text-body-secondary">@_vm.Item.SubscriptionName</div>
		</div>
		<a class="btn btn-outline-secondary" href="items">返回列表</a>
	</div>

	@if (!string.IsNullOrEmpty(_vm.Message))
	{
		<div class="alert @(_vm.Succeeded ? "alert-success" : "alert-danger")">@_vm.Message</div>
	}

	<div class="card mb-3">
		<div class="card-body">
			<h2 class="h5">原始条目</h2>
			<p class="feed-title">@_vm.Item.Title</p>
			<dl class="row mb-0">
				<dt class="col-sm-3">发布时间</dt><dd class="col-sm-9">@(_vm.Item.PublishedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "未知")</dd>
				<dt class="col-sm-3">来源页面</dt>
				<dd class="col-sm-9">
					@if (_vm.Item.Link is not null)
					{
						<a href="@_vm.Item.Link" target="_blank" rel="noopener noreferrer">打开条目页面</a>
					}
					else
					{
						<span>—</span>
					}
				</dd>
				<dt class="col-sm-3">Torrent</dt><dd class="col-sm-9">@(_vm.Item.TorrentUrl is null ? "未提供" : "已发现")</dd>
			</dl>
		</div>
	</div>

	<div class="row g-3 mb-3">
		<div class="col-lg-6">
			<div class="card h-100">
				<div class="card-body">
					<h2 class="h5">解析结果</h2>
					<dl class="row mb-0">
						<dt class="col-5">标题</dt><dd class="col-7">@(_vm.Item.ParsedTitle ?? "—")</dd>
						<dt class="col-5">媒体类型</dt><dd class="col-7">@(_vm.Item.MediaType ?? "—")</dd>
						<dt class="col-5">集数 / 版本</dt><dd class="col-7">@(_vm.Item.Episode?.ToString() ?? "—") / v@_vm.Item.Version</dd>
						<dt class="col-5">字幕组</dt><dd class="col-7">@(_vm.Item.Group ?? "—")</dd>
						<dt class="col-5">语言</dt><dd class="col-7">@(_vm.Item.Language ?? "—")</dd>
						<dt class="col-5">分辨率</dt><dd class="col-7">@(_vm.Item.Resolution ?? "—")</dd>
					</dl>
				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="card h-100">
				<div class="card-body">
					<h2 class="h5">Subject 与决策</h2>
					<p>
						<span class="badge @FeedItems.StatusClass(_vm.Item.Status)">@FeedItems.StatusText(_vm.Item.Status)</span>
					</p>
					<dl class="row">
						<dt class="col-5">Subject</dt>
						<dd class="col-7">
							@if (_vm.Item.SubjectId is not null)
							{
								<a href="https://bgm.tv/subject/@_vm.Item.SubjectId" target="_blank" rel="noopener noreferrer">@(_vm.Item.SubjectName ?? $"#{_vm.Item.SubjectId}")</a>
							}
							else
							{
								<span>未关联</span>
							}
						</dd>
						<dt class="col-5">偏好标签</dt><dd class="col-7">@(_vm.Item.Preference ?? "—")</dd>
						<dt class="col-5">同集选择</dt>
						<dd class="col-7">
							@(_vm.Item.SelectionOutcome switch
							{
								SelectionOutcome.Winner  => "当前优胜候选",
								SelectionOutcome.RunnerUp => "组内落选（保留候选，规则变化后可重新参与）",
								_                         => "尚未参与择优"
							})
							@if (_vm.Item.SelectionRuleVersion is { } ruleVersion)
							{
								<div class="small text-body-secondary">
									择优规则版本 v@ruleVersion@(string.IsNullOrWhiteSpace(_vm.Item.SelectionBasis)
										                            ? ""
										                            : $"；组内优胜依据：{_vm.Item.SelectionBasis}")
								</div>
							}
						</dd>
						<dt class="col-5">命名预览</dt>
						<dd class="col-7">
							<code>@(_vm.Item.NamingPreview ?? "—")</code>
						</dd>
					</dl>
					<div class="alert alert-light border mb-0">
						<strong>决策理由：</strong>@_vm.Item.Reason
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="card mb-3">
		<div class="card-body">
			<h2 class="h5">下载</h2>
			@if (_vm.Item.Download is { } download)
			{
				<p>
					<span class="badge text-bg-secondary">@DownloadStatusText(download.Status, download.IsUserPaused)</span>
					@if (download.Progress is not null)
					{
						<span class="ms-2">@(download.Progress.Value.ToString("0.0%"))</span>
					}
					@if (!string.IsNullOrEmpty(download.Error))
					{
						<span class="text-danger ms-2">@download.FailedStep：@download.Error</span>
					}
				</p>
				<a class="btn btn-sm btn-outline-secondary" href="downloads">查看下载任务</a>
			}
			@if (_vm.CanCreateDownload)
			{
				@if (_vm.Item.Download is null)
				{
					<p class="text-body-secondary mb-2">按当前决策与命名快照创建下载任务，提交与对账由后台自动完成。</p>
				}

				<button class="btn btn-primary" disabled="@_vm.Saving" @onclick="() => CreateDownloadAsync()">
					@(_vm.Saving ? "正在创建…" : "创建下载任务")
				</button>
			}
		</div>
	</div>

	<EditForm Model="_vm.Correction" OnValidSubmit="ReevaluateAsync" FormName="subject-correction">
		<DataAnnotationsValidator/>
		<div class="card">
			<div class="card-body">
				<h2 class="h5">人工修正 Subject</h2>
				<p class="text-body-secondary">指定新的 Bangumi Subject 后，会复用同一解析、集数修正、筛选与命名规则重新评估。表单默认填入标题映射记录的原始 Subject，无法取得时留空，请显式填写。</p>
				<div class="input-group correction-input">
					<span class="input-group-text">Subject ID</span>
					<InputNumber class="form-control" @bind-Value="_vm.Correction.SubjectId"/>
					<button class="btn btn-primary" type="submit" disabled="@_vm.Saving">@(_vm.Saving ? "评估中…" : "修正并重新评估")</button>
				</div>
				<ValidationMessage For="() => _vm.Correction.SubjectId"/>
			</div>
		</div>
	</EditForm>
}

@code {

	[Parameter]
	public Guid Id { get; set; }

	private readonly CancellationTokenSource      _cts = new();
	private          FeedItemDetailsPageViewModel _vm  = null!;

	protected override void OnInitialized()
	{
		_vm = new FeedItemDetailsPageViewModel(Queries, Evaluator, DownloadService, Logger);
	}

	protected override Task OnParametersSetAsync()
	{
		return RunAsync(token => _vm.LoadAsync(Id, token));
	}

	private Task ReevaluateAsync()
	{
		return RunAsync(token => _vm.ReevaluateAsync(Id, token));
	}

	private Task CreateDownloadAsync()
	{
		return RunAsync(token => _vm.CreateDownloadAsync(Id, token));
	}

	private static string DownloadStatusText(DownloadTaskStatus status, bool isUserPaused)
	{
		return status switch
		{
			DownloadTaskStatus.PendingSubmit => "等待提交",
			DownloadTaskStatus.Submitting    => "提交结果待确认",
			DownloadTaskStatus.Downloading   => "下载中",
			DownloadTaskStatus.Paused        => isUserPaused ? "已暂停（人工）" : "已暂停",
			DownloadTaskStatus.Completed     => "已完成",
			DownloadTaskStatus.Failed        => "失败",
			DownloadTaskStatus.Lost          => "任务丢失",
			DownloadTaskStatus.Replaced      => "已被替换",
			_                                => status.ToString()
		};
	}

	/// <summary>页面离开后取消进行中的查询属于预期，不向线路报错。</summary>
	private async Task RunAsync(Func<CancellationToken, Task> operation)
	{
		try
		{
			await operation(_cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	public void Dispose()
	{
		_cts.Cancel();
		_cts.Dispose();
	}

}
