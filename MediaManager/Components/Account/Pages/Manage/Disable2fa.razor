@page "/Account/Manage/Disable2fa"
@using MediaManager.Data
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager      RedirectManager
@inject ILogger<Disable2fa>          Logger

<PageTitle>关闭两步验证（2FA） - MediaManager</PageTitle>

<StatusMessage/>
<h3>关闭两步验证（2FA）</h3>

<div class="alert alert-warning" role="alert">
	<p>
		<strong>此操作仅关闭两步验证。</strong>
	</p>
	<p>
		关闭两步验证不会更改身份验证器应用中使用的密钥。如需更换密钥，请
		<a href="Account/Manage/ResetAuthenticator">重置身份验证器密钥</a>。
	</p>
</div>

<div>
	<form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
		<AntiforgeryToken/>
		<button class="btn btn-danger" type="submit">关闭两步验证</button>
	</form>
</div>

@code {
	private ApplicationUser? user;

	[CascadingParameter]
	private HttpContext HttpContext { get; set; } = null!;

	protected override async Task OnInitializedAsync()
	{
		user = await UserManager.GetUserAsync(HttpContext.User);
		if (user is null)
		{
			RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
			return;
		}

		if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
		{
			throw new InvalidOperationException("用户当前未启用两步验证，无法关闭。");
		}
	}

	private async Task OnSubmitAsync()
	{
		if (user is null)
		{
			RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
			return;
		}

		var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
		if (!disable2faResult.Succeeded)
		{
			throw new InvalidOperationException("关闭两步验证时发生意外错误。");
		}

		var userId = await UserManager.GetUserIdAsync(user);
		Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
		RedirectManager.RedirectToWithStatus("Account/Manage/TwoFactorAuthentication", "两步验证已关闭。配置身份验证器应用后可重新开启。", HttpContext);
	}

}
