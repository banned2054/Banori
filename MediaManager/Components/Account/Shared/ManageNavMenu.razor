@using MediaManager.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<div class="card mb-4">
	<div class="card-body p-2">
		<ul class="nav nav-pills flex-column">
			<li class="nav-item">
				<NavLink class="nav-link" href="Account/Manage" Match="NavLinkMatch.All">个人资料</NavLink>
			</li>
			<li class="nav-item">
				<NavLink class="nav-link" href="Account/Manage/Email">邮箱</NavLink>
			</li>
			<li class="nav-item">
				<NavLink class="nav-link" href="Account/Manage/ChangePassword">密码</NavLink>
			</li>
			@if (hasExternalLogins)
			{
				<li class="nav-item">
					<NavLink class="nav-link" href="Account/Manage/ExternalLogins">外部登录</NavLink>
				</li>
			}
			<li class="nav-item">
				<NavLink class="nav-link" href="Account/Manage/TwoFactorAuthentication">两步验证</NavLink>
			</li>
			<li class="nav-item">
				<NavLink class="nav-link" href="Account/Manage/Passkeys">通行密钥</NavLink>
			</li>
			<li class="nav-item">
				<NavLink class="nav-link" href="Account/Manage/PersonalData">个人数据</NavLink>
			</li>
		</ul>
	</div>
</div>

@code {
	private bool hasExternalLogins;

	protected override async Task OnInitializedAsync()
	{
		hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
	}

}
