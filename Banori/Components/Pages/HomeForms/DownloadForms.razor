@using System.ComponentModel.DataAnnotations
@using Banori.Features.Downloads
@using Banori.Features.Proxies
@rendermode InteractiveServer
@inject DownloadIntakeService  Intake
@inject ProxyService           ProxyService
@inject ILogger<DownloadForms> Logger

@* 总览页的下载登记表单：Torrent 上传与 RSS 链接下载两套卡片、共用忙碌与结果状态。
   表单草稿与提交状态随组件生命周期管理；上传大小等约束由登记入口（服务端）统一校验。 *@

<div class="d-flex flex-wrap gap-2 mb-3">
	<button type="button" class="btn btn-primary" aria-expanded="@_showTorrentForm" @onclick="ToggleTorrentForm">
		<span class="bi bi-cloud-arrow-down me-1" aria-hidden="true"></span>添加 Torrent 下载
	</button>
	<button type="button" class="btn btn-outline-primary" aria-expanded="@_showRssForm" @onclick="ToggleRssForm">
		<span class="bi bi-rss me-1" aria-hidden="true"></span>RSS 链接下载
	</button>
</div>

@if (_showTorrentForm)
{
	<div class="card mb-3">
		<div class="card-body">
			<h2 class="h5">添加 Torrent 下载</h2>
			<p class="text-body-secondary small">选择种子后确认加入；任务不关联订阅与条目。每个种子都必须绑定 Bangumi：标题映射未命中时需填写 Bangumi ID，绑定后按 Bangumi 作品名（中文名优先）命名。</p>
			<div class="row g-3 align-items-end">
				<div class="col-md-7">
					<label class="form-label" for="dashboard-torrent-file">Torrent 文件</label>
					<div>
						<InputFile id="dashboard-torrent-file" class="visually-hidden" accept=".torrent"
						           disabled="@_busy" OnChange="SelectTorrentFile"/>
						<label for="dashboard-torrent-file" class="btn btn-outline-primary mb-0 @(_busy ? "disabled" : string.Empty)">
							选择 .torrent 文件
						</label>
						@if (_torrentFile is not null)
						{
							<span class="ms-2">@_torrentFile.Name</span>
						}
						else
						{
							<span class="ms-2 small text-body-secondary">最大 @(DownloadIntakeService.MaxTorrentUploadBytes / 1024 / 1024) MB</span>
						}
					</div>
				</div>
				<div class="col-md-5 d-flex gap-2 align-items-end">
					<div class="flex-grow-1">
						<label class="form-label" for="dashboard-torrent-subject">Bangumi ID（可选）</label>
						<input id="dashboard-torrent-subject" class="form-control" type="number" min="1"
						       placeholder="标题映射未命中时必填" disabled="@_busy" @bind="_torrentSubjectId"/>
						<div class="form-text">bgm.tv/subject/ 后面的数字。</div>
					</div>
				</div>
				<div class="col-md-12 d-flex gap-2">
					<button type="button" class="btn btn-primary" disabled="@(_busy || _torrentFile is null)"
					        @onclick="ConfirmTorrentDownload">
						@(_busy ? "正在登记…" : "确认并加入下载")
					</button>
					<button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="ToggleTorrentForm">取消</button>
				</div>
			</div>
		</div>
	</div>
}

@if (_showRssForm)
{
	<EditForm Model="_rssDraft" OnValidSubmit="DownloadFromRss" FormName="dashboard-rss-download">
		<DataAnnotationsValidator/>
		<div class="card mb-3">
			<div class="card-body">
				<h2 class="h5">RSS 链接下载</h2>
				<p class="text-body-secondary small">抓取 RSS 中的所有条目，每个条目登记为一个下载任务；不创建订阅，重复资源自动跳过。每个条目都必须绑定 Bangumi：按标题映射、feed 自带信息或条目链接自动识别，全部未命中时需在下方补充 Bangumi ID 后重试。</p>
				<div class="row g-3">
					<div class="col-md-7">
						<label class="form-label" for="dashboard-rss-url">RSS 地址</label>
						<InputText id="dashboard-rss-url" class="form-control" type="url"
						           @bind-Value="_rssDraft.FeedUrl"/>
						<ValidationMessage For="() => _rssDraft.FeedUrl"/>
					</div>
					<div class="col-md-5">
						<label class="form-label" for="dashboard-rss-proxy">代理（可选）</label>
						<select id="dashboard-rss-proxy" class="form-select" @bind="_rssDraft.ProxyId">
							<option value="">不使用代理（直连）</option>
							@foreach (var proxy in _proxies)
							{
								<option value="@proxy.Id">@proxy.Name</option>
							}
						</select>
						<div class="form-text">RSS 抓取与种子下载都走此代理。代理可在<a href="settings#network-proxy">设置的「网络代理」</a>中维护。</div>
					</div>
					<div class="col-md-4">
						<label class="form-label" for="dashboard-rss-subject">Bangumi ID（可选）</label>
						<input id="dashboard-rss-subject" class="form-control" type="number" min="1"
						       placeholder="自动识别失败时必填" disabled="@_busy" @bind="_rssDraft.SubjectId"/>
						<div class="form-text">整份 feed 视为同一部作品时填写；bgm.tv/subject/ 后面的数字。</div>
					</div>
				</div>
				<div class="mt-3 d-flex gap-2">
					<button type="submit" class="btn btn-primary" disabled="@_busy">
						@(_busy ? "正在抓取…" : "抓取并登记下载")
					</button>
					<button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="ToggleRssForm">取消</button>
				</div>
			</div>
		</div>
	</EditForm>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
	<div class="alert @(_operationSucceeded ? "alert-success" : "alert-danger")" role="status">
		<div>@_message</div>
		@if (_rssResult is not null)
		{
			var detailItems = _rssResult.Items.Where(item => item.Outcome != RssDownloadItemOutcome.Created).ToList();
			@if (detailItems.Count > 0)
			{
				<ul class="mb-0 mt-2 ps-3 small">
					@foreach (var item in detailItems)
					{
						<li>
							<span class="text-break">@item.Title</span>：
							@(item.Outcome switch
							{
								RssDownloadItemOutcome.Duplicate  => "跳过（重复）",
								RssDownloadItemOutcome.Superseded => "跳过（同集择优）",
								_                                 => "失败"
							})
							@if (!string.IsNullOrWhiteSpace(item.Error) &&
							     item.Error != "同一资源已有下载任务。")
							{
								<span class="text-body-secondary">@item.Error</span>
							}
						</li>
					}
				</ul>
			}
		}
	</div>
}

@code {
	private IReadOnlyList<ProxyView> _proxies  = [];
	private RssDownloadDraft         _rssDraft = new();
	private RssDownloadResult?       _rssResult;
	private IBrowserFile?            _torrentFile;
	private int?                     _torrentSubjectId;
	private bool                     _showTorrentForm;
	private bool                     _showRssForm;
	private bool                     _busy;
	private bool                     _operationSucceeded;
	private string?                  _message;

	protected override async Task OnInitializedAsync()
	{
		_proxies = await ProxyService.ListAsync();
	}

	private void ToggleTorrentForm()
	{
		_showTorrentForm = !_showTorrentForm;
		if (_showTorrentForm) _showRssForm = false;
		else _torrentFile                  = null;
		_message = null;
	}

	private void ToggleRssForm()
	{
		_showRssForm = !_showRssForm;
		if (_showRssForm) _showTorrentForm = false;
		_message   = null;
		_rssResult = null;
	}

	private void SelectTorrentFile(InputFileChangeEventArgs args)
	{
		_torrentFile = args.File;
		_message     = null;
	}

	private async Task ConfirmTorrentDownload()
	{
		if (_torrentFile is null) return;

		_busy    = true;
		_message = null;
		try
		{
			if (_torrentFile.Size > DownloadIntakeService.MaxTorrentUploadBytes)
				throw new InvalidOperationException("种子文件超过 10 MB，已拒绝。");

			await using var fileStream = _torrentFile.OpenReadStream(
			                                                         DownloadIntakeService.MaxTorrentUploadBytes);
			using var buffer = new MemoryStream();
			await fileStream.CopyToAsync(buffer);
			await Intake.CreateFromUploadAsync(buffer.ToArray(), null, _torrentSubjectId);
			_operationSucceeded = true;
			_message            = "Torrent 已登记，等待提交下载器。";
			_torrentFile        = null;
			_torrentSubjectId   = null;
			_showTorrentForm    = false;
		}
		catch (InvalidOperationException exception)
		{
			_operationSucceeded = false;
			_message            = exception.Message;
		}
		catch (Exception exception)
		{
			Logger.LogWarning(exception, "总览页上传 Torrent 失败。");
			_operationSucceeded = false;
			_message            = "上传或登记失败，请查看服务日志。";
		}
		finally
		{
			_busy = false;
		}
	}

	private async Task DownloadFromRss()
	{
		_busy      = true;
		_message   = null;
		_rssResult = null;
		try
		{
			var proxyId = Guid.TryParse(_rssDraft.ProxyId, out var parsed) ? parsed : (Guid?)null;
			var result  = await Intake.CreateFromRssFeedAsync(_rssDraft.FeedUrl, proxyId, _rssDraft.SubjectId);
			_rssResult = result;
			if (result.CreatedCount == 0 && !result.HasChanges && result.SupersededCount == 0)
			{
				_operationSucceeded = false;
				_message            = "没有登记任何下载任务，请查看失败明细。";
			}
			else
			{
				_operationSucceeded = true;
				_message = $"RSS 抓取完成：新建 {result.CreatedCount} 个下载任务"                                        +
				           (result.DuplicateCount  > 0 ? $"，跳过重复 {result.DuplicateCount} 个" : string.Empty)  +
				           (result.SupersededCount > 0 ? $"，择优跳过 {result.SupersededCount} 个" : string.Empty) +
				           (result.FailedCount     > 0 ? $"，失败 {result.FailedCount} 个" : string.Empty)       +
				           "。任务列表见下载页。";
				_rssDraft.Reset();
				_showRssForm = false;
			}
		}
		catch (ArgumentException exception)
		{
			_operationSucceeded = false;
			_message            = exception.Message;
		}
		catch (Exception exception)
		{
			Logger.LogWarning(exception, "总览页 RSS 链接下载失败。");
			_operationSucceeded = false;
			_message            = "RSS 抓取失败，请查看服务日志。";
		}
		finally
		{
			_busy = false;
		}
	}

	/// <summary>RSS 链接下载表单：RSS 地址必填，代理与 Bangumi ID 可选。</summary>
	private sealed class RssDownloadDraft
	{
		[Required(ErrorMessage = "请填写 RSS 地址。")]
		public string FeedUrl { get; set; } = string.Empty;

		/// <summary>代理下拉的绑定值（代理 Id 的字符串形式）；空表示直连。</summary>
		public string? ProxyId { get; set; }

		/// <summary>整份 feed 统一绑定的 Bangumi Subject ID；自动识别失败时由用户显式提供。</summary>
		public int? SubjectId { get; set; }

		public void Reset()
		{
			FeedUrl   = string.Empty;
			ProxyId   = null;
			SubjectId = null;
		}
	}

}
