		])
	];

	[Parameter]
	public string? Tab { get; set; }

	private readonly CancellationTokenSource _cts                 = new();
	private          SettingsPageViewModel   _vm                  = null!;
	private          string                  _activeTab           = DownloaderTab;
	private          TemplateField           _activeTemplateField = TemplateField.Torrent;

	protected override void OnInitialized()
	{
		_vm = new SettingsPageViewModel(DownloaderSettings, NamingTemplates, DirectorySettings, TelegramSettings, GotifySettings,
		                                ProxyService, Logger);
	}

	protected override void OnParametersSet()
	{
		var resolved = NormalizeTab(Tab);
		if (resolved != _activeTab)
		{
			_activeTab = resolved;
			_vm.ClearMessages();
		}
	}

	protected override Task OnInitializedAsync() => RunAsync(_vm.LoadAsync);

	private bool IsTab(string tab) => string.Equals(_activeTab, tab, StringComparison.Ordinal);

	private static string NormalizeTab(string? tab) =>
		tab?.Trim().ToLowerInvariant() switch
		{
			NamingTab         => NamingTab,
			SelectionRulesTab => SelectionRulesTab,
			NotificationsTab  => NotificationsTab,
			ProxiesTab        => ProxiesTab,
			_                 => DownloaderTab
		};

	private static string ProtocolLabel(ProxyProtocol protocol) =>
		protocol switch
		{
			ProxyProtocol.Socks4 => "SOCKS4",
			ProxyProtocol.Socks5 => "SOCKS5",
			_                    => "HTTP"
		};

	private string ActiveTemplateLabel() =>
		_activeTemplateField switch
		{
			TemplateField.Collection => "合集种子名称模板",
			TemplateField.File       => "种子内文件名称模板",
			_                        => "qB 种子名称模板"
		};

	private void InsertToken(string token)
	{
		switch (_activeTemplateField)
		{
			case TemplateField.Collection:
				_vm.Naming.CollectionNamingTemplate = (_vm.Naming.CollectionNamingTemplate ?? string.Empty) + token;
				break;
			case TemplateField.File:
				_vm.Naming.FileNamingTemplate = (_vm.Naming.FileNamingTemplate ?? string.Empty) + token;
				break;
			default:
				_vm.Naming.NamingTemplate = (_vm.Naming.NamingTemplate ?? string.Empty) + token;
				break;
		}
	}

	private void ResetTorrentTemplate() => _vm.Naming.NamingTemplate = _vm.DefaultNamingTemplate;

	private void ResetCollectionTemplate() => _vm.Naming.CollectionNamingTemplate = string.Empty;

	private void ResetFileTemplate() => _vm.Naming.FileNamingTemplate = _vm.DefaultFileNamingTemplate;

	private void ApplyFolderFilePreset() =>
		_vm.Naming.FileNamingTemplate = "{bgm.nameCn}/{bgm.nameCn} - E{ani.episode:ee} [{ani.group}]";

	private Task SaveDownloaderAsync() => RunAsync(_vm.SaveDownloaderAsync);

	private Task SaveNamingAsync() => RunAsync(_vm.SaveNamingAsync);

	private Task SaveTelegramAsync() => RunAsync(_vm.SaveTelegramAsync);

	private Task SaveGotifyAsync() => RunAsync(_vm.SaveGotifyAsync);

	private Task TestDownloaderAsync() => RunAsync(_vm.TestDownloaderAsync);

	private Task RegenerateHookTokenAsync() => RunAsync(_vm.RegenerateHookTokenAsync);

	private Task TestTelegramAsync() => RunAsync(_vm.TestTelegramAsync);

	private Task TestGotifyAsync() => RunAsync(_vm.TestGotifyAsync);

	private Task ReloadProxiesAsync() => RunAsync(_vm.ReloadProxiesAsync);

	/// <summary>页面离开后取消进行中的查询属于预期，不向线路报错。</summary>
	private async Task RunAsync(Func<CancellationToken, Task> operation)
	{
		try
		{
			await operation(_cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	public void Dispose()
	{
		_cts.Cancel();
		_cts.Dispose();
	}

}
