	private async Task UploadTorrentAsync(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file is null) return;

		try
		{
			await using var stream = file.OpenReadStream(DownloadIntakeService.MaxTorrentUploadBytes + 1024 * 1024);
			await _vm.UploadTorrentAsync(stream, _cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
		catch (IOException)
		{
			_vm.NoteFailure("读取上传文件失败，请重试。");
		}
	}

	private async Task RunOperationAsync(Func<Task> operation)
	{
		try
		{
			await operation();
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	private static string DownloadStatusTitle(DownloadTaskView task)
	{
		var subject  = string.IsNullOrWhiteSpace(task.SubjectName) ? task.NamingSnapshot : task.SubjectName;
		var episode  = task.Episode is null ? string.Empty : $" 第{task.Episode:0.##}集";
		var language = string.IsNullOrWhiteSpace(task.SubtitleLanguage) ? string.Empty : $" {task.SubtitleLanguage}";
		// 命名要素的 Group 在无字幕组名时回退存语言名，与语言相同只展示一个。
		var group = string.IsNullOrWhiteSpace(task.SubtitleGroup) ||
		            string.Equals(task.SubtitleGroup, task.SubtitleLanguage, StringComparison.OrdinalIgnoreCase)
			? string.Empty
			: $" {task.SubtitleGroup}";
		var version = task.Version > 1 ? $" v{task.Version}" : string.Empty;
		return $"{subject}{episode}{language}{group}{version}";
	}

	/// <summary>异常态最多附加一个提示徽章，详情与恢复操作统一放在下面板。</summary>
	private static string? AttentionBadge(DownloadTaskView task)
	{
		if (!string.IsNullOrEmpty(task.Error)) return "错误";
		if (task.IsTorrentMissing) return "缺种";
		if (task.ArchiveReviewReason is not null) return "待核对";
		if (task.Phase == DownloadDisplayPhase.VerificationUnconfirmed) return "校验未确认";
		return null;
	}

	private static string StatusClass(DownloadDisplayPhase phase)
	{
		return phase switch
		{
			// 准备与校验等待属于受控推进，用 info 区分于真实下载的 primary；
			// 需要用户注意或人工干预的等待（停止确认、隔离迁移、添加确认）用 warning。
			DownloadDisplayPhase.Preparing or
				DownloadDisplayPhase.PreparingLayout or
				DownloadDisplayPhase.WaitingCheckStart or
				DownloadDisplayPhase.Checking or
				DownloadDisplayPhase.WaitingResultStable or
				DownloadDisplayPhase.WaitingStartConfirm => "text-bg-info",
			DownloadDisplayPhase.WaitingAddConfirm       => "text-bg-warning",
			DownloadDisplayPhase.WaitingStopConfirm      => "text-bg-warning",
			DownloadDisplayPhase.IsolationMigrating      => "text-bg-warning",
			DownloadDisplayPhase.VerificationUnconfirmed => "text-bg-warning",
			DownloadDisplayPhase.WaitingSubmit           => "text-bg-secondary",
			DownloadDisplayPhase.Archiving               => "text-bg-success",
			DownloadDisplayPhase.Downloading             => "text-bg-primary",
			DownloadDisplayPhase.PausedManually or
				DownloadDisplayPhase.PausedByDownloader or
				DownloadDisplayPhase.Paused => "text-bg-secondary",
			DownloadDisplayPhase.Completed => "text-bg-success",
			DownloadDisplayPhase.Failed    => "text-bg-danger",
			DownloadDisplayPhase.Lost      => "text-bg-danger",
			DownloadDisplayPhase.Replaced  => "text-bg-dark",
			_                              => "text-bg-light"
		};
	}

	public async ValueTask DisposeAsync()
	{
		_vm.ResultsChanged -= OnResultsChanged;
		_cts.Cancel();
		_cts.Dispose();
		_timer?.Dispose();
		_vm.Dispose();
		if (_splitterHandle is not null)
		{
			try
			{
				await _splitterHandle.DisposeAsync();
			}
			catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException)
			{
			}
		}

		if (_jsModule is not null)
		{
			try
			{
				await _jsModule.DisposeAsync();
			}
			catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException)
			{
			}
		}
	}
}
