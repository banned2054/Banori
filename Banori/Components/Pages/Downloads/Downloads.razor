@page "/downloads"
@rendermode InteractiveServer
@attribute [Authorize]
@using Banori.Components.Shared
@using Banori.Features.Downloads
@using System.Globalization
@implements IAsyncDisposable

@inject DownloadService                     DownloadService
@inject DownloadIntakeService               IntakeService
@inject DownloadTaskQueries                 TaskQueries
@inject DownloadTaskFilterStore             FilterStore
@inject DownloadFileService                 FileService
@inject DownloadTaskChangeNotifier          ChangeNotifier
@inject QbittorrentMainDataSyncService      MainDataSyncService
@inject TimeProvider                        TimeProvider
@inject ILogger<DownloadTasksPageViewModel> Logger
@inject IJSRuntime                          JsRuntime

<PageTitle>下载任务 - Banori</PageTitle>

<div class="downloads-page" @ref="_pageRef" data-pane-expanded="@(_detailsExpanded ? "true" : "false")"
     data-batch-mode="@(_vm.BatchMode ? "true" : "false")">
	<div class="downloads-top-bar d-flex justify-content-end align-items-center gap-2">
		<DownloadIntakeActions @ref="_intakeActions"
		                       IdPrefix="downloads"
		                       Align="end"
		                       SmallButtons="true"
		                       OutlineButtonClass="btn-outline-secondary"
		                       Disabled="_vm.Busy"
		                       OnPanelOpening="CloseFilterPanels"
		                       OnCompleted="HandleIntakeCompletedAsync"/>
		<div class="d-flex gap-2 flex-shrink-0">
			@if (_vm.BatchMode)
			{
				<button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_vm.Busy || _vm.SelectedCount == 0)"
				        @onclick="OpenBulkDeletePanelAsync">
					删除所选（@_vm.SelectedCount）
				</button>
				<button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_vm.Busy" @onclick="_vm.ToggleBatchMode">
					退出批量选择
				</button>
			}
			else
			{
				<button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_vm.Busy || _vm.TotalCount == 0)"
				        @onclick="_vm.ToggleBatchMode">
					批量选择
				</button>
			}
		</div>
	</div>

	@if (_vm.Loaded)
	{
		<div class="downloads-toolbar d-flex flex-wrap align-items-center gap-2">
			<input class="form-control" style="max-width: 260px;" type="search" placeholder="搜索标题、字幕组"
			       aria-label="搜索下载任务" @bind="_vm.SearchText" @bind:event="oninput"/>
			<div class="position-relative">
				<button type="button" class="btn dropdown-toggle @(_vm.StatusFilterActive ? "btn-primary" : "btn-outline-secondary")"
				        aria-expanded="@_statusPanelOpen" @onclick="ToggleStatusPanel">
					状态@(_vm.StatusFilterActive ? $"（{_vm.StatusFilter.Count}/{DownloadStatusFilter.Choices.Count}）" : string.Empty)
				</button>
				@if (_statusPanelOpen)
				{
					<div class="position-absolute bg-body border rounded shadow-sm p-2 mt-1 overflow-auto"
					     style="z-index: 1055; min-width: 11rem; max-height: 20rem;">
						<div class="d-flex justify-content-between align-items-center gap-3 border-bottom pb-1 mb-1">
							<button type="button" class="btn btn-link btn-sm p-0" @onclick="_vm.SelectAllStatusesAsync">全选</button>
							<button type="button" class="btn btn-link btn-sm p-0 text-body-secondary" @onclick="_vm.DeselectAllStatusesAsync">全不选</button>
						</div>
						@for (var i = 0; i < DownloadStatusFilter.Choices.Count; i++)
						{
							var group = DownloadStatusFilter.Choices[i];
							<div class="form-check">
								<input type="checkbox" class="form-check-input" id="status-filter-@i"
								       checked="@_vm.StatusFilter.Contains(group)" @onchange="() => _vm.ToggleStatusFilterAsync(group)"/>
								<label class="form-check-label" for="status-filter-@i">@DownloadStatusFilter.Text(group)</label>
							</div>
						}
					</div>
				}
			</div>
			<div class="position-relative">
				<button type="button" class="btn dropdown-toggle @(_vm.LanguageFilter.Count > 0 ? "btn-primary" : "btn-outline-secondary")"
				        aria-expanded="@_languagePanelOpen" @onclick="ToggleLanguagePanel">
					字幕语言@(_vm.LanguageFilter.Count > 0 ? $"（{_vm.LanguageFilter.Count}）" : string.Empty)
				</button>
				@if (_languagePanelOpen)
				{
					<div class="position-absolute bg-body border rounded shadow-sm p-2 mt-1 overflow-auto"
					     style="z-index: 1055; min-width: 8rem; max-height: 20rem;">
						@for (var i = 0; i < _vm.AvailableLanguages.Count; i++)
						{
							var language = _vm.AvailableLanguages[i];
							<div class="form-check">
								<input type="checkbox" class="form-check-input" id="language-filter-@i"
								       checked="@_vm.LanguageFilter.Contains(language)" @onchange="() => _vm.ToggleLanguageFilterAsync(language)"/>
								<label class="form-check-label" for="language-filter-@i">@(language.Length == 0 ? "（无语言）" : language)</label>
							</div>
						}
					</div>
				}
			</div>
			@if (_vm.HasActiveFilters)
			{
				<button type="button" class="btn btn-outline-secondary" @onclick="_vm.ClearFiltersAsync">清除筛选</button>
			}
			<span class="ms-auto small text-body-secondary">共 @_vm.TotalCount 个任务</span>
		</div>
	}

	<div class="downloads-workspace">
		<div class="downloads-list-pane" @ref="_listPaneRef">
			@if (!_vm.Loaded)
			{
				<p class="p-3">正在加载…</p>
			}
			else if (_vm is { TotalCount: 0, HasActiveFilters: false })
			{
				<p class="text-body-secondary p-3">还没有下载任务。点击右上角「上传种子」或「RSS 链接下载」添加任务。</p>
			}
			else
			{
				<table class="table table-sm align-middle downloads-table">
					<thead>
					<tr>
						@if (_vm.BatchMode)
						{
							<th style="width: 1rem;">
								<input type="checkbox" class="form-check-input mt-0" aria-label="勾选可见行" title="勾选可见行"
								       checked="@_vm.AllSelected" @onchange="_vm.ToggleSelectAll"/>
							</th>
						}
						<th aria-sort="@AriaSort(DownloadTaskSortColumn.AnimeName)">
							<button type="button" class="downloads-sort-header @(IsSortActive(DownloadTaskSortColumn.AnimeName) ? "is-active" : null)"
							        @onclick="() => _vm.SortByColumnAsync(DownloadTaskSortColumn.AnimeName)">
								<span>动画名</span>
								@if (IsSortActive(DownloadTaskSortColumn.AnimeName))
								{
									<span aria-hidden="true">@(_vm.SortDescending ? "↓" : "↑")</span>
								}
							</button>
						</th>
						<th aria-sort="@AriaSort(DownloadTaskSortColumn.Episode)">
							<button type="button" class="downloads-sort-header @(IsSortActive(DownloadTaskSortColumn.Episode) ? "is-active" : null)"
							        @onclick="() => _vm.SortByColumnAsync(DownloadTaskSortColumn.Episode)">
								<span>集数</span>
								@if (IsSortActive(DownloadTaskSortColumn.Episode))
								{
									<span aria-hidden="true">@(_vm.SortDescending ? "↓" : "↑")</span>
								}
							</button>
						</th>
						<th aria-sort="@AriaSort(DownloadTaskSortColumn.Version)">
							<button type="button" class="downloads-sort-header @(IsSortActive(DownloadTaskSortColumn.Version) ? "is-active" : null)"
							        @onclick="() => _vm.SortByColumnAsync(DownloadTaskSortColumn.Version)">
								<span>版本</span>
								@if (IsSortActive(DownloadTaskSortColumn.Version))
								{
									<span aria-hidden="true">@(_vm.SortDescending ? "↓" : "↑")</span>
								}
							</button>
						</th>
						<th aria-sort="@AriaSort(DownloadTaskSortColumn.SubtitleGroup)">
							<button type="button" class="downloads-sort-header @(IsSortActive(DownloadTaskSortColumn.SubtitleGroup) ? "is-active" : null)"
							        @onclick="() => _vm.SortByColumnAsync(DownloadTaskSortColumn.SubtitleGroup)">
								<span>字幕组</span>
								@if (IsSortActive(DownloadTaskSortColumn.SubtitleGroup))
								{
									<span aria-hidden="true">@(_vm.SortDescending ? "↓" : "↑")</span>
								}
							</button>
						</th>
						<th aria-sort="@AriaSort(DownloadTaskSortColumn.Language)">
							<button type="button" class="downloads-sort-header @(IsSortActive(DownloadTaskSortColumn.Language) ? "is-active" : null)"
							        @onclick="() => _vm.SortByColumnAsync(DownloadTaskSortColumn.Language)">
								<span>语言</span>
								@if (IsSortActive(DownloadTaskSortColumn.Language))
								{
									<span aria-hidden="true">@(_vm.SortDescending ? "↓" : "↑")</span>
								}
							</button>
						</th>
						<th>来源</th>
						<th>状态</th>
						<th>进度</th>
						<th aria-sort="@AriaSort(DownloadTaskSortColumn.CreatedAt)">
							<button type="button" class="downloads-sort-header @(IsSortActive(DownloadTaskSortColumn.CreatedAt) ? "is-active" : null)"
							        @onclick="() => _vm.SortByColumnAsync(DownloadTaskSortColumn.CreatedAt)">
								<span>创建时间</span>
								@if (IsSortActive(DownloadTaskSortColumn.CreatedAt))
								{
									<span aria-hidden="true">@(_vm.SortDescending ? "↓" : "↑")</span>
								}
							</button>
						</th>
						<th>完成时间</th>
					</tr>
					</thead>
					<tbody>
					@if (_vm.TotalCount == 0)
					{
						<tr>
							<td colspan="@(_vm.BatchMode ? 11 : 10)" class="text-body-secondary">
								没有符合筛选条件的任务。<button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="_vm.ClearFiltersAsync">清除筛选</button>
							</td>
						</tr>
					}
					else
					{
						@if (_vm.TopSpacerHeightPx > 0)
						{
							<tr class="downloads-spacer" aria-hidden="true" style="height: @(_vm.TopSpacerHeightPx)px;">
								<td colspan="@(_vm.BatchMode ? 11 : 10)" style="height: @(_vm.TopSpacerHeightPx)px;"></td>
							</tr>
						}
						@foreach (var task in _vm.Tasks)
						{
							<tr @key="task.Id" class="downloads-row @(IsSelected(task.Id) ? "table-active" : null)"
							    @onclick="() => SelectTaskAsync(task)"
							    @oncontextmenu="e => OpenContextMenuAsync(e, task)" @oncontextmenu:preventDefault="@(!_vm.BatchMode)">
							@if (_vm.BatchMode)
							{
								<td>
									<input type="checkbox" class="form-check-input mt-0"
									       aria-label="选择 @task.NamingSnapshot"
									       checked="@_vm.IsSelected(task.Id)" @onchange="() => _vm.ToggleSelected(task.Id)"/>
								</td>
							}
							<td>
								@{ var animeTitle = AnimeTitle(task); }
								<div class="downloads-anime-title fw-semibold" title="@(animeTitle == "—" ? null : animeTitle)">@animeTitle</div>
							</td>
							<td class="downloads-episode-cell">
								@if (task.EpisodeTooltip is { } episodeTooltip)
								{
									<span class="downloads-episode-gapped" title="@episodeTooltip">@task.EpisodeDisplay</span>
								}
								else
								{
									<span class="@(task.EpisodeDisplay == "—" ? "text-body-secondary" : null)">@task.EpisodeDisplay</span>
								}
							</td>
							<td class="downloads-version-cell">
								@if (task.Version > 1)
								{
									<span class="badge text-bg-secondary">v@(task.Version)</span>
								}
								else
								{
									<span class="text-body-secondary">—</span>
								}
							</td>
							<td>
								@if (SubtitleGroup(task) is { } group)
								{
									<div class="downloads-group-title" title="@group">@group</div>
								}
								else
								{
									<span class="text-body-secondary">—</span>
								}
							</td>
							<td class="downloads-language-cell">
								@if (string.IsNullOrWhiteSpace(task.SubtitleLanguage))
								{
									<span class="text-body-secondary">—</span>
								}
								else
								{
									@task.SubtitleLanguage
								}
							</td>
							<td class="downloads-site-cell">
								@if (string.IsNullOrWhiteSpace(task.SiteSource))
								{
									<span class="text-body-secondary">—</span>
								}
								else
								{
									<span class="badge text-bg-info downloads-site-badge">@task.SiteSource</span>
								}
							</td>
							<td class="downloads-status-cell">
								<span class="badge @StatusClass(task.Phase)">@task.StatusText</span>
								@if (AttentionBadge(task) is { } attention)
								{
									<span class="badge text-bg-warning ms-1">@attention</span>
								}
							</td>
							<td class="downloads-progress-cell">
								@if (task is { ShowsProgress: true, Progress: { } progress })
								{
									<div class="downloads-progress-wrap">
										<div class="progress flex-grow-1" style="height: 6px;">
											<div class="progress-bar" style="width: @(Math.Clamp(progress * 100, 0, 100).ToString("0.#"))%;"></div>
										</div>
										<span class="small text-body-secondary">@task.ProgressCaption@(progress.ToString("0.0%"))</span>
									</div>
								}
								else
								{
									<span class="text-body-secondary">—</span>
								}
							</td>
							<td class="downloads-created-cell" title="@(task.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture))">
								<span class="small text-body-secondary">@(task.CreatedAtUtc.ToLocalTime().ToString("MM-dd HH:mm", CultureInfo.InvariantCulture))</span>
							</td>
							<td class="downloads-completed-cell" title="@(task.CompletedAtUtc is { } completedAt ? completedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) : null)">
								@if (task.CompletedAtUtc is { } completed)
								{
									<span class="small text-body-secondary">@(completed.ToLocalTime().ToString("MM-dd HH:mm", CultureInfo.InvariantCulture))</span>
								}
								else
								{
									<span class="text-body-secondary">—</span>
								}
							</td>
						</tr>
						}
						@if (_vm.BottomSpacerHeightPx > 0)
						{
							<tr class="downloads-spacer" aria-hidden="true" style="height: @(_vm.BottomSpacerHeightPx)px;">
								<td colspan="@(_vm.BatchMode ? 11 : 10)" style="height: @(_vm.BottomSpacerHeightPx)px;"></td>
							</tr>
						}
					}
					</tbody>
				</table>
			}
		</div>

		<div class="downloads-splitter @(_detailsExpanded ? null : "is-hidden")" role="separator"
		     aria-orientation="horizontal" aria-label="拖动调整详情面板高度" title="拖动调整详情面板高度"></div>

		<div class="downloads-detail-pane @(_detailsExpanded ? "is-expanded" : "is-collapsed")">
			<div class="downloads-detail-bar d-flex flex-wrap justify-content-between align-items-center gap-2">
				<div class="btn-group btn-group-sm" role="tablist" aria-label="任务详情视图">
					<button type="button" role="tab" aria-selected="@(_activeTab == DetailTab.Details)"
					        class="btn btn-sm @(_activeTab == DetailTab.Details ? "btn-primary" : "btn-outline-secondary")"
					        @onclick="() => SwitchTabAsync(DetailTab.Details)">详细信息</button>
					<button type="button" role="tab" aria-selected="@(_activeTab == DetailTab.Files)"
					        class="btn btn-sm @(_activeTab == DetailTab.Files ? "btn-primary" : "btn-outline-secondary")"
					        @onclick="() => SwitchTabAsync(DetailTab.Files)">文件列表</button>
				</div>
				<div class="d-flex align-items-center gap-2 min-w-0">
					@if (_vm.SelectedTask is { } paneTask)
					{
						<span class="small text-body-secondary text-truncate downloads-task-title">@DownloadStatusTitle(paneTask)</span>
					}
					<button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0"
					        aria-expanded="@_detailsExpanded" @onclick="ToggleDetailsPaneAsync">
						@(_detailsExpanded ? "收起面板" : "展开面板")
					</button>
				</div>
			</div>
			@if (_detailsExpanded)
			{
				<div class="downloads-detail-content" role="tabpanel">
					@if (_vm.SelectedTask is { } task)
					{
						@if (_activeTab == DetailTab.Details)
						{
							<DownloadTaskDetails Task="task"
							                     Busy="_vm.Busy"
							                     StatusBadgeClass="@StatusClass(task.Phase)"
							                     TaskActions="NormalTaskActions"
							                     OnRetry="RetryAsync"
							                     OnRetryArchive="RetryArchiveAsync"
							                     OnRedownload="RedownloadAsync"
							                     OnReverify="ReverifyAsync"
							                     OnDelete="@(t => OpenDeletePanelAsync(t))"
							                     CopyTextAsync="@(text => CopyTextAsync(text))"/>
						}
						else
						{
							<DownloadTaskFiles TaskId="task.Id" ViewModel="_vm" AutoRefreshMode="true" CancellationToken="_cts.Token"/>
						}
					}
					else
					{
						<div class="p-3 small downloads-pane-placeholder">点击上方列表中的任务查看详细信息与文件列表</div>
					}
				</div>
			}
		</div>
	</div>

	@if (!string.IsNullOrEmpty(_vm.Message))
	{
		<div class="alert @(_vm.Succeeded ? "alert-success" : "alert-danger") downloads-message mt-3" role="status">
			<div>@_vm.Message</div>
			<DownloadIntakeRssDetails Result="_rssResult"/>
		</div>
	}

	@if (_contextMenuOpen && _vm.SelectedTask is { } contextTask)
	{
		<div style="position: fixed; inset: 0; z-index: 1079;"
		     @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
		<div @ref="_contextMenuRef" tabindex="-1" class="dropdown-menu d-block show shadow"
		     @onclick="CloseContextMenu" @onkeydown="OnContextMenuKeyDown"
		     style="position: fixed; left: @(_contextMenuX)px; top: @(_contextMenuY)px; z-index: 1080; min-width: 11rem;">
			<div class="dropdown-header text-truncate">@DownloadStatusTitle(contextTask)</div>
			<div class="d-grid gap-1 px-2 py-1">
				@TaskActions(contextTask)
				<button type="button" class="btn btn-sm btn-outline-secondary"
				        @onclick="() => OpenTaskTabAsync(contextTask, DetailTab.Details)">查看详细信息</button>
				<button type="button" class="btn btn-sm btn-outline-secondary"
				        @onclick="() => OpenTaskTabAsync(contextTask, DetailTab.Files)">查看文件列表</button>
				<button type="button" class="btn btn-sm btn-outline-danger" disabled="@_vm.Busy"
				        @onclick="() => OpenDeletePanelAsync(contextTask)">删除</button>
			</div>
		</div>
	}

	@if (_vm.DeleteTarget is { } deleteTarget)
	{
		<div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-task-title">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h2 id="delete-task-title" class="modal-title h5">删除下载任务</h2>
						<button type="button" class="btn-close" aria-label="关闭" disabled="@_vm.Busy" @onclick="_vm.CancelDelete"></button>
					</div>
					<div class="modal-body">
						<p class="mb-2">将删除任务记录「@DownloadStatusTitle(deleteTarget)」。</p>
						@if (_vm.TorrentInDownloader == false)
						{
							<p class="text-body-secondary small mb-0">下载器中没有该任务的种子，仅删除本应用中的记录。</p>
						}
						else
						{
							@if (_vm.TorrentInDownloader is null)
							{
								<p class="text-body-secondary small">暂时无法确认下载器状态，是否同时删除下载器中的种子由你决定。</p>
							}

							<div class="form-check">
								<input id="delete-downloader-torrent" class="form-check-input" type="checkbox"
								       disabled="@_vm.Busy" @bind="_vm.DeleteFromDownloader"/>
								<label class="form-check-label" for="delete-downloader-torrent">同时删除 qBittorrent 中的种子</label>
							</div>
							@if (_vm.DeleteFromDownloader)
							{
								<div class="form-check mt-2">
									<input id="delete-downloader-files" class="form-check-input" type="checkbox"
									       disabled="@_vm.Busy" @bind="_vm.DeleteFiles"/>
									<label class="form-check-label" for="delete-downloader-files">
										同时删除已下载的文件<span class="text-danger">（从磁盘删除，不可恢复）</span>
									</label>
								</div>
							}
						}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-outline-secondary" disabled="@_vm.Busy" @onclick="_vm.CancelDelete">取消</button>
						<button type="button" class="btn btn-danger" disabled="@_vm.Busy" @onclick="() => DeleteAsync(deleteTarget.Id)">
							@(_vm.Busy ? "正在删除…" : "删除")
						</button>
					</div>
				</div>
			</div>
		</div>
		<div class="modal-backdrop fade show"></div>
	}

	@if (_vm is { BulkDeletePanelOpen: true, BulkPrecheck: { } precheck })
	{
		var showDownloaderOptions = !precheck.DownloaderChecked || precheck.TorrentsInDownloader > 0;
		<div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="bulk-delete-title">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h2 id="bulk-delete-title" class="modal-title h5">批量删除下载任务</h2>
						<button type="button" class="btn-close" aria-label="关闭" disabled="@_vm.Busy" @onclick="_vm.CancelBulkDelete"></button>
					</div>
					<div class="modal-body">
						<p class="mb-2">将删除 @precheck.TaskCount 个任务的记录。</p>
						@if (showDownloaderOptions)
						{
							@if (!precheck.DownloaderChecked)
							{
								<p class="text-body-secondary small">暂时无法确认下载器状态，是否同时删除下载器中的种子由你决定。</p>
							}
							else if (precheck.TorrentsInDownloader < precheck.TaskCount)
							{
								<p class="text-body-secondary small">所选任务中有 @precheck.TorrentsInDownloader 个在下载器中存在种子。</p>
							}

							<div class="form-check">
								<input id="bulk-delete-downloader-torrent" class="form-check-input" type="checkbox"
								       disabled="@_vm.Busy" @bind="_vm.DeleteFromDownloader"/>
								<label class="form-check-label" for="bulk-delete-downloader-torrent">同时删除 qBittorrent 中的种子</label>
							</div>
							@if (_vm.DeleteFromDownloader)
							{
								<div class="form-check mt-2">
									<input id="bulk-delete-downloader-files" class="form-check-input" type="checkbox"
									       disabled="@_vm.Busy" @bind="_vm.DeleteFiles"/>
									<label class="form-check-label" for="bulk-delete-downloader-files">
										同时删除已下载的文件<span class="text-danger">（从磁盘删除，不可恢复）</span>
									</label>
								</div>
							}
						}
						else
						{
							<p class="text-body-secondary small mb-0">下载器中没有这些任务的种子，仅删除本应用中的记录。</p>
						}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-outline-secondary" disabled="@_vm.Busy" @onclick="_vm.CancelBulkDelete">取消</button>
						<button type="button" class="btn btn-danger" disabled="@_vm.Busy" @onclick="ConfirmBulkDeleteAsync">
							@(_vm.Busy ? "正在删除…" : $"删除 {precheck.TaskCount} 个任务")
						</button>
					</div>
				</div>
			</div>
		</div>
		<div class="modal-backdrop fade show"></div>
	}
</div>

@code {
	private enum DetailTab
	{
		Details,
		Files
	}

	private readonly CancellationTokenSource                 _cts                = new();
	private readonly Lock                                    _changeLock         = new();
	private readonly HashSet<Guid>                           _pendingChangedIds  = [];
	private readonly SemaphoreSlim                           _refreshSignal      = new(0, 1);
	private          DownloadTasksPageViewModel              _vm                 = null!;
	private          IDisposable?                            _changeSubscription;
	private          IDisposable?                            _mainDataSubscription;
	private          bool                                    _disposed;
	private          Task?                                   _refreshLoop;
	private          DownloadIntakeActions?                  _intakeActions;
	private          RssDownloadResult?                      _rssResult;
	private          bool                                    _statusPanelOpen;
	private          bool                                    _languagePanelOpen;
	private          bool                                    _detailsExpanded;
	private          DetailTab                               _activeTab          = DetailTab.Details;
	private          bool                                    _contextMenuOpen;
	private          double                                  _contextMenuX;
	private          double                                  _contextMenuY;
	private          ElementReference                        _contextMenuRef;
	private          ElementReference                        _pageRef;
	private          ElementReference                        _listPaneRef;
	private          bool                                    _focusContextMenu;
	private          bool                                    _pendingOrderOrMembership;
	private          bool                                    _hasPendingChange;
	private          bool                                    _isPageHidden;
	private          bool                                    _dirtyWhileHidden;
	private          IJSObjectReference?                     _jsModule;
	private          IJSObjectReference?                     _splitterHandle;
	private          IJSObjectReference?                     _virtualListHandle;
	private          DotNetObjectReference<Downloads>?       _selfRef;

	/// <summary>右键菜单保留全部动作；详情头部只显示非异常态动作，恢复按钮统一放在异常提示框。</summary>
	private RenderFragment<DownloadTaskView> TaskActions => task => @<text>
		@switch (task.Status)
		{
			// 启动未恢复的人工入口：不重新校验、不隔离、不重新下载。
			case DownloadTaskStatus.Downloading when task.RunState == DownloadRunStates.FailedRetryable:
				<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Busy" @onclick="() => ResumeRunAsync(task.Id)">继续下载</button>
				break;
			case DownloadTaskStatus.Downloading:
				<button class="btn btn-sm btn-outline-secondary" disabled="@_vm.Busy" @onclick="() => PauseAsync(task.Id)">暂停</button>
				break;
			case DownloadTaskStatus.Paused when task.Phase == DownloadDisplayPhase.VerificationUnconfirmed:
				<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Busy" @onclick="() => ReverifyAsync(task.Id)">重新校验</button>
				break;
			case DownloadTaskStatus.Paused when task.IsUserPaused:
				<button class="btn btn-sm btn-outline-secondary" disabled="@_vm.Busy" @onclick="() => ResumeAsync(task.Id)">恢复</button>
				break;
			case DownloadTaskStatus.Completed when task.IsTorrentMissing:
				<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Busy" @onclick="() => RedownloadAsync(task.Id)">重新下载</button>
				break;
			case DownloadTaskStatus.Completed when task.RunState is DownloadRunStates.FailedRetryable or DownloadRunStates.DownloaderStopped:
				<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Busy" @onclick="() => ResumeRunAsync(task.Id)">恢复做种</button>
				break;
			case DownloadTaskStatus.Failed or DownloadTaskStatus.Lost:
				<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Busy" @onclick="() => RetryAsync(task.Id)">重试</button>
				break;
		}

		@if (task.ArchiveReviewReason is not null && task.Status == DownloadTaskStatus.Completed)
		{
			<button class="btn btn-sm btn-outline-warning" disabled="@_vm.Busy" @onclick="() => RetryArchiveAsync(task.Id)">重新核对归档</button>
		}
	</text>;

	private RenderFragment<DownloadTaskView> NormalTaskActions => task => @<text>
		@switch (task.Status)
		{
			case DownloadTaskStatus.Downloading when task.RunState == DownloadRunStates.FailedRetryable:
				<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Busy" @onclick="() => ResumeRunAsync(task.Id)">继续下载</button>
				break;
			case DownloadTaskStatus.Downloading:
				<button class="btn btn-sm btn-outline-secondary" disabled="@_vm.Busy" @onclick="() => PauseAsync(task.Id)">暂停</button>
				break;
			case DownloadTaskStatus.Paused when task.IsUserPaused && task.Phase != DownloadDisplayPhase.VerificationUnconfirmed:
				<button class="btn btn-sm btn-outline-secondary" disabled="@_vm.Busy" @onclick="() => ResumeAsync(task.Id)">恢复</button>
				break;
			case DownloadTaskStatus.Completed when task.RunState is DownloadRunStates.FailedRetryable or DownloadRunStates.DownloaderStopped:
				<button class="btn btn-sm btn-outline-primary" disabled="@_vm.Busy" @onclick="() => ResumeRunAsync(task.Id)">恢复做种</button>
				break;
		}
	</text>;

	protected override void OnInitialized()
	{
		_vm = new DownloadTasksPageViewModel(DownloadService, IntakeService, TaskQueries, FilterStore, Logger,
		                                     FileService, TimeProvider);
		_vm.ResultsChanged    += OnResultsChanged;
		_changeSubscription   =  ChangeNotifier.Subscribe(OnTasksChanged);
		_mainDataSubscription =  MainDataSyncService.Subscribe(OnMainDataUpdated);
	}

	/// <summary>后台防抖加载落幕后刷新界面；与事件处理器自身的渲染可能重复，无副作用。</summary>
	private void OnResultsChanged() => _ = InvokeAsync(StateHasChanged);

	private void OnMainDataUpdated(QbittorrentMainDataSnapshot snapshot) =>
		_ = InvokeAsync(() =>
		{
			if (!_disposed) _vm.ApplyMainDataSnapshot(snapshot);
		});

	private void OnTasksChanged(DownloadTaskChangedEvent changedEvent)
	{
		lock (_changeLock)
		{
			_pendingChangedIds.UnionWith(changedEvent.TaskIds);
			_pendingOrderOrMembership |= changedEvent.AffectsListOrderOrMembership;
			_hasPendingChange         =  true;
			if (_isPageHidden)
			{
				_dirtyWhileHidden = true;
				return;
			}
		}

		SignalRefresh();
	}

	private void SignalRefresh()
	{
		try
		{
			if (_refreshSignal.CurrentCount == 0) _refreshSignal.Release();
		}
		catch (ObjectDisposedException)
		{
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await _vm.LoadAsync(_cts.Token);
		_refreshLoop = RefreshLoopAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender) await InitializeJsAsync();
		if (_jsModule is not null && _vm.ConsumePendingScrollTopPx() is { } scrollTop)
		{
			try
			{
				await _jsModule.InvokeVoidAsync("setScrollTop", _listPaneRef, scrollTop);
			}
			catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException or JSException)
			{
			}
		}

		if (!_focusContextMenu) return;

		_focusContextMenu = false;
		await _contextMenuRef.FocusAsync();
	}

	/// <summary>JS 增强不可用时保留纯 Blazor 交互，不阻断页面加载。</summary>
	private async Task InitializeJsAsync()
	{
		try
		{
			_jsModule =
				await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Downloads/Downloads.razor.js");
			_splitterHandle = await _jsModule.InvokeAsync<IJSObjectReference>("initializeDetailPane", _pageRef);
			_selfRef        = DotNetObjectReference.Create(this);
			_virtualListHandle = await _jsModule.InvokeAsync<IJSObjectReference>(
				"initializeVirtualList", _listPaneRef, _selfRef, DownloadTasksPageViewModel.RowHeightPx);
		}
		catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException or JSException)
		{
		}
	}

	[JSInvokable]
	public async Task OnViewportChangedAsync(int visibleStartIndex, int visibleCount)
	{
		try
		{
			await _vm.SetViewportAsync(visibleStartIndex, visibleCount, _cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	[JSInvokable]
	public Task OnVisibilityChangedAsync(bool hidden)
	{
		if (_disposed) return Task.CompletedTask;
		bool shouldRefreshNow;
		lock (_changeLock)
		{
			_isPageHidden = hidden;
			if (hidden)
			{
				SyncFilePanelPolling();
				shouldRefreshNow = false;
			}
			else
			{
				shouldRefreshNow  = _dirtyWhileHidden || _hasPendingChange;
				_dirtyWhileHidden = false;
			}
		}

		if (hidden)
		{
			_mainDataSubscription?.Dispose();
			_mainDataSubscription = null;
			return Task.CompletedTask;
		}

		_mainDataSubscription ??= MainDataSyncService.Subscribe(OnMainDataUpdated);
		SyncFilePanelPolling();
		// 回到前台立即刷新当前可见窗口；文件面板若处于展开的文件列表 Tab，SyncFilePanelPolling 已立即触发一次同步。
		SignalRefresh();
		if (shouldRefreshNow) return InvokeAsync(StateHasChanged);
		return Task.CompletedTask;
	}

	private async Task<bool> CopyTextAsync(string text)
	{
		if (_jsModule is null) return false;
		try
		{
			return await _jsModule.InvokeAsync<bool>("copyText", text);
		}
		catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException or JSException)
		{
			return false;
		}
	}

	/// <summary>浮层互斥打开：点按钮切换开合，勾选选项不影响开合。</summary>
	private void CloseFilterPanels()
	{
		_statusPanelOpen   = false;
		_languagePanelOpen = false;
	}

	private void ToggleStatusPanel()
	{
		_statusPanelOpen   = !_statusPanelOpen;
		_languagePanelOpen = false;
		_intakeActions?.ClosePanels();
	}

	private void ToggleLanguagePanel()
	{
		_languagePanelOpen = !_languagePanelOpen;
		_statusPanelOpen   = false;
		_intakeActions?.ClosePanels();
	}

	/// <summary>串行前台刷新循环：数据库提交通知立即唤醒，15 秒兜底；页面隐藏时暂停。</summary>
	private async Task RefreshLoopAsync()
	{
		try
		{
			while (!_cts.IsCancellationRequested)
			{
				var triggeredBySignal = await _refreshSignal.WaitAsync(TimeSpan.FromSeconds(15), _cts.Token);
				if (_cts.IsCancellationRequested) break;

				if (_isPageHidden)
				{
					lock (_changeLock) _dirtyWhileHidden = true;
					continue;
				}

				if (_vm.Busy) continue;

				Guid[] changedIds;
				bool   affectsOrderOrMembership;
				bool   hasPendingChange;
				lock (_changeLock)
				{
					hasPendingChange          = _hasPendingChange;
					affectsOrderOrMembership  = _pendingOrderOrMembership;
					changedIds                = [.. _pendingChangedIds];
					_hasPendingChange         = false;
					_pendingOrderOrMembership = false;
					_pendingChangedIds.Clear();
				}

				if (!triggeredBySignal || !hasPendingChange || affectsOrderOrMembership)
					await InvokeAsync(() => _vm.RefreshFallbackAsync(_cts.Token));
				else
					await InvokeAsync(() => _vm.RefreshChangedTasksAsync(changedIds, false, _cts.Token));
			}
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
		catch (ObjectDisposedException)
		{
		}
	}

	private void SyncFilePanelPolling() =>
		_vm.SetFilePanelActive(_detailsExpanded, _activeTab == DetailTab.Files, _vm.SelectedTaskId, _isPageHidden);

	private bool IsSelected(Guid taskId)
	{
		return !_vm.BatchMode && _vm.SelectedTaskId == taskId;
	}

	/// <summary>点击列表行：仅选中任务，不改变下面板展开/折叠状态；批量模式不联动。</summary>
	private async Task SelectTaskAsync(DownloadTaskView task)
	{
		if (_vm.BatchMode) return;

		_contextMenuOpen = false;
		await RunOperationAsync(() => _vm.SelectTaskAsync(task.Id, _cts.Token));
		SyncFilePanelPolling();
	}

	/// <summary>右键菜单的查看入口：选中任务、切到目标页签并展开下面板；批量模式不联动。</summary>
	private async Task OpenTaskTabAsync(DownloadTaskView task, DetailTab tab)
	{
		if (_vm.BatchMode) return;

		_activeTab       = tab;
		_detailsExpanded = true;
		_contextMenuOpen = false;
		await RunOperationAsync(() => _vm.SelectTaskAsync(task.Id, _cts.Token));
		SyncFilePanelPolling();
	}

	private void SwitchTabAsync(DetailTab tab)
	{
		_activeTab       = tab;
		_detailsExpanded = true;
		SyncFilePanelPolling();
	}

	private void ToggleDetailsPaneAsync()
	{
		_detailsExpanded = !_detailsExpanded;
		SyncFilePanelPolling();
	}

	private async Task OpenContextMenuAsync(MouseEventArgs e, DownloadTaskView task)
	{
		if (_vm.BatchMode) return;

		_contextMenuOpen  = true;
		_contextMenuX     = e.ClientX;
		_contextMenuY     = e.ClientY;
		_focusContextMenu = true;
		await RunOperationAsync(() => _vm.SelectTaskAsync(task.Id, _cts.Token));
		SyncFilePanelPolling();
	}

	private void CloseContextMenu()
	{
		_contextMenuOpen = false;
	}

	private void OnContextMenuKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Escape")
		{
			CloseContextMenu();
		}
	}

	private Task PauseAsync(Guid taskId)
	{
		return RunOperationAsync(() => _vm.PauseAsync(taskId, _cts.Token));
	}

	private Task ResumeAsync(Guid taskId)
	{
		return RunOperationAsync(() => _vm.ResumeAsync(taskId, _cts.Token));
	}

	private Task RetryAsync(Guid taskId)
	{
		return RunOperationAsync(() => _vm.RetryAsync(taskId, _cts.Token));
	}

	/// <summary>种子丢失后重新下载：沿用原决策重新提交，完成记录与逐集归属不变。</summary>
	private Task RedownloadAsync(Guid taskId)
	{
		return RunOperationAsync(() => _vm.RedownloadAsync(taskId, _cts.Token));
	}

	private Task ReverifyAsync(Guid taskId)
	{
		return RunOperationAsync(() => _vm.ReverifyAsync(taskId, _cts.Token));
	}

	/// <summary>人工恢复启动：完成后的任务恢复做种，部分完成继续下载；不重新校验、不隔离。</summary>
	private Task ResumeRunAsync(Guid taskId)
	{
		return RunOperationAsync(() => _vm.ResumeRunAsync(taskId, _cts.Token));
	}

	private Task RetryArchiveAsync(Guid taskId)
	{
		return RunOperationAsync(() => _vm.RetryArchiveAsync(taskId, _cts.Token));
	}

	private async Task OpenDeletePanelAsync(DownloadTaskView task)
	{
		try
		{
			await _vm.PrepareDeleteAsync(task, _cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	private async Task DeleteAsync(Guid taskId)
	{
		await RunOperationAsync(() => _vm.DeleteAsync(taskId, _cts.Token));
		SyncFilePanelPolling();
	}

	private async Task OpenBulkDeletePanelAsync()
	{
		try
		{
			await _vm.PrepareBulkDeleteAsync(_cts.Token);
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	private async Task ConfirmBulkDeleteAsync()
	{
		try
		{
			await _vm.ConfirmBulkDeleteAsync(_cts.Token);
			SyncFilePanelPolling();
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	private async Task HandleIntakeCompletedAsync(DownloadIntakeFeedback feedback)
	{
		_rssResult = feedback.Succeeded ? null : feedback.RssResult;
		var shouldReload = feedback.Succeeded || (feedback.RssResult?.CreatedCount ?? 0) > 0;
		await RunOperationAsync(() => _vm.ApplyIntakeFeedbackAsync(feedback.Succeeded, feedback.Message, shouldReload,
		                                                           _cts.Token),
		                        clearRssResult : false);
	}

	private async Task RunOperationAsync(Func<Task> operation, bool clearRssResult = true)
	{
		if (clearRssResult) _rssResult = null;
		try
		{
			await operation();
		}
		catch (OperationCanceledException) when (_cts.IsCancellationRequested)
		{
		}
	}

	/// <summary>列表动画名：中文名优先，依次回退命名快照与 RSS 标题。</summary>
	private bool IsSortActive(DownloadTaskSortColumn column) => _vm.SortColumn == column;

	private string? AriaSort(DownloadTaskSortColumn column) =>
		_vm.SortColumn != column ? null : _vm.SortDescending ? "descending" : "ascending";

	private static string AnimeTitle(DownloadTaskView task)
	{
		if (!string.IsNullOrWhiteSpace(task.SubjectName)) return task.SubjectName;
		if (!string.IsNullOrWhiteSpace(task.NamingSnapshot)) return task.NamingSnapshot;
		if (!string.IsNullOrWhiteSpace(task.TorrentName)) return task.TorrentName;
		return "—";
	}

	/// <summary>字幕组判重：与详情面板同一口径，无组名或回退存语言名时不单独展示。</summary>
	private static string? SubtitleGroup(DownloadTaskView task) =>
		string.IsNullOrWhiteSpace(task.SubtitleGroup) ||
		string.Equals(task.SubtitleGroup, task.SubtitleLanguage, StringComparison.OrdinalIgnoreCase)
			? null
			: task.SubtitleGroup;

	private static string DownloadStatusTitle(DownloadTaskView task)
	{
		var subject  = string.IsNullOrWhiteSpace(task.SubjectName) ? task.NamingSnapshot : task.SubjectName;
		var episode  = task.Episode is null ? string.Empty : $" 第{task.Episode:0.##}集";
		var language = string.IsNullOrWhiteSpace(task.SubtitleLanguage) ? string.Empty : $" {task.SubtitleLanguage}";
		// 命名要素的 Group 在无字幕组名时回退存语言名，与语言相同只展示一个。
		var group = string.IsNullOrWhiteSpace(task.SubtitleGroup) ||
		            string.Equals(task.SubtitleGroup, task.SubtitleLanguage, StringComparison.OrdinalIgnoreCase)
			? string.Empty
			: $" {task.SubtitleGroup}";
		var version = task.Version > 1 ? $" v{task.Version}" : string.Empty;
		return $"{subject}{episode}{language}{group}{version}";
	}

	/// <summary>异常态最多附加一个提示徽章，详情与恢复操作统一放在下面板。</summary>
	private static string? AttentionBadge(DownloadTaskView task)
	{
		if (!string.IsNullOrEmpty(task.Error)) return "错误";
		if (task.IsTorrentMissing) return "缺种";
		if (task.ArchiveReviewReason is not null) return "待核对";
		if (task.Phase == DownloadDisplayPhase.VerificationUnconfirmed) return "校验未确认";
		return null;
	}

	private static string StatusClass(DownloadDisplayPhase phase)
	{
		return phase switch
		{
			// 准备与校验等待属于受控推进，用 info 区分于真实下载的 primary；
			// 需要用户注意或人工干预的等待（停止确认、隔离迁移、添加确认）用 warning。
			DownloadDisplayPhase.Preparing or
				DownloadDisplayPhase.PreparingLayout or
				DownloadDisplayPhase.WaitingCheckStart or
				DownloadDisplayPhase.Checking or
				DownloadDisplayPhase.WaitingResultStable or
				DownloadDisplayPhase.WaitingStartConfirm => "text-bg-info",
			DownloadDisplayPhase.WaitingAddConfirm       => "text-bg-warning",
			DownloadDisplayPhase.WaitingStopConfirm      => "text-bg-warning",
			DownloadDisplayPhase.IsolationMigrating      => "text-bg-warning",
			DownloadDisplayPhase.VerificationUnconfirmed => "text-bg-warning",
			DownloadDisplayPhase.WaitingSubmit           => "text-bg-secondary",
			DownloadDisplayPhase.Archiving               => "text-bg-success",
			DownloadDisplayPhase.Downloading             => "text-bg-primary",
			DownloadDisplayPhase.PausedManually or
				DownloadDisplayPhase.PausedByDownloader or
				DownloadDisplayPhase.Paused => "text-bg-secondary",
			DownloadDisplayPhase.Completed => "text-bg-success",
			DownloadDisplayPhase.Failed    => "text-bg-danger",
			DownloadDisplayPhase.Lost      => "text-bg-danger",
			DownloadDisplayPhase.Replaced  => "text-bg-dark",
			_                              => "text-bg-light"
		};
	}

	public async ValueTask DisposeAsync()
	{
		_disposed = true;
		_mainDataSubscription?.Dispose();
		_mainDataSubscription = null;
		_changeSubscription?.Dispose();
		_vm.ResultsChanged -= OnResultsChanged;
		_cts.Cancel();
		_cts.Dispose();
		_refreshSignal.Dispose();
		_vm.Dispose();
		if (_virtualListHandle is not null)
		{
			try
			{
				await _virtualListHandle.InvokeVoidAsync("dispose");
				await _virtualListHandle.DisposeAsync();
			}
			catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException)
			{
			}
		}

		if (_splitterHandle is not null)
		{
			try
			{
				await _splitterHandle.InvokeVoidAsync("dispose");
				await _splitterHandle.DisposeAsync();
			}
			catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException)
			{
			}
		}

		if (_jsModule is not null)
		{
			try
			{
				await _jsModule.DisposeAsync();
			}
			catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException)
			{
			}
		}

		_selfRef?.Dispose();
	}
}
